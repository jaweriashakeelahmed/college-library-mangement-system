rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /systemSettings/staffAuthentication {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /books/{document=**} {
      allow read: if true;
      allow write: if true; // Temporarily allow for seed
    }
    match /{document=**} {
      allow read, write: if true; // Actually let's temporarily allow all so we don't break the app until auth is fully tested
    }
  }
}
